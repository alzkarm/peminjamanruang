datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum BookingStatus {
  PENDING
  VERIFIED
  RECOMMENDED
  APPROVED
  REJECTED
  RETURNED
  CANCELED
  EXPIRED
  RESCHEDULE_PENDING
  NO_SHOW
}

enum ActivityType {
  SEMINAR
  WORKSHOP
  PELATIHAN
  RAPAT
  KUNJUNGAN
  KULIAH_TAMU
  KULIAH
  AKREDITASI
  UJIAN_CBT
  LAINNYA
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String?
  fullName     String
  email        String?
  unitName     String
  role         Role     @default(USER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings    Booking[]
  approvals   ApprovalLog[]
  feedbacks   Feedback[]
  cbtBookings CbtSeatBooking[]
  penalties   UserPenalty[]
  notifications Notification[]

  @@map("users")
}

model Floor {
  id    Int    @id @default(autoincrement())
  name  String @unique
  level Int
  rooms Room[]

  @@map("floors")
}

model Room {
  id            String   @id @default(uuid())
  floorId       Int
  name          String
  code          String?  @unique
  building      String   @default("")
  capacity      Int?
  isSpecialRoom Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  floor        Floor             @relation(fields: [floorId], references: [id])
  bookings     Booking[]
  maintenances RoomMaintenance[]

  @@index([name])
  @@map("rooms")
}

model Booking {
  id                   String        @id @default(uuid())
  userId               String
  roomId               String
  title                String
  activityType         ActivityType  @default(SEMINAR)
  startTime            DateTime      
  endTime              DateTime      
  status               BookingStatus @default(PENDING)
  estimatedAttendees   Int?
  additionalFacilities Json @default("[]")
  notes                String?
  attachmentUrl        String?
  dokumenUrl           String?
  passToken            String?       @unique @map("pass_token")
  isCheckedIn          Boolean       @default(false)
  isLeaderApproved     Boolean       @default(false)
  isAcademicBulk       Boolean       @default(false)
  bulkGroupId          String?
  rescheduleReason     String?
  originalSchedule     String?
  rescheduleRoomId     String?
  rescheduleStartTime  DateTime?
  rescheduleEndTime    DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  room               Room                    @relation(fields: [roomId], references: [id])
  logistik           BookingLogistik[]
  approvalLogs       ApprovalLog[]
  feedback           Feedback?
  readinessChecklist RoomReadinessChecklist?
  penalties          UserPenalty[]
  notifications      Notification[]

  @@index([roomId, startTime, endTime])
  @@index([status, startTime, endTime])
  @@index([userId])
  @@map("bookings")
}

model BookingLogistik {
  id        String   @id @default(uuid())
  bookingId String
  jenisItem String
  jumlah    Int
  catatan   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_logistik")
}

model ApprovalLog {
  id         String        @id @default(uuid())
  bookingId  String
  approverId String
  fromStatus BookingStatus
  toStatus   BookingStatus
  notes      String?
  createdAt  DateTime      @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  approver User    @relation(fields: [approverId], references: [id])

  @@index([bookingId, createdAt])
  @@map("approval_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  bookingId String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([bookingId])
  @@map("notifications")
}

model Feedback {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  userId            String
  cleanlinessRating Int
  facilityRating    Int
  staffRating       Int
  overallRating     Float
  comments          String?
  reportedIssues    String?
  createdAt         DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

model RoomReadinessChecklist {
  id                 String   @id @default(uuid())
  bookingId          String   @unique
  isAcReady          Boolean  @default(false)
  isAudioReady       Boolean  @default(false)
  isLogisticsReady   Boolean  @default(false)
  isCleanlinessReady Boolean  @default(false)
  checkedBy          String?
  notes              String?
  updatedAt          DateTime @updatedAt

  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("room_readiness_checklists")
}

enum CbtRoomType {
  A
  B
}

enum CbtBookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model CbtRoom {
  id        CbtRoomType @id @default(A)
  name      String
  capacity  Int
  isActive  Boolean     @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seatBookings CbtSeatBooking[]

  @@map("cbt_rooms")
}

model CbtSeatBooking {
  id        String           @id @default(uuid())
  userId    String
  roomId    CbtRoomType      @default(A)
  faculty   String
  title     String
  seatStart Int
  seatEnd   Int
  startTime DateTime         
  endTime   DateTime         
  status    CbtBookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id])
  room  CbtRoom  @relation(fields: [roomId], references: [id])

  @@index([roomId, startTime, endTime])
  @@index([startTime, endTime])
  @@index([status])
  @@map("cbt_seat_bookings")
}

model Faculty {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  colorBg     String?  @default("#3B82F6")
  colorText   String?  @default("#FFFFFF")
  colorBorder String?  @default("#2563EB")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faculties")
}

model Facility {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   @default("audio_visual")
  description String?
  icon        String?  @default("Package")
  isSpecial   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("facilities")
}

model RoomMaintenance {
  id          String   @id @default(uuid())
  roomId      String
  title       String
  description String?
  startTime   DateTime 
  endTime     DateTime 
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
  @@map("room_maintenances")
}

model UserPenalty {
  id               String   @id @default(uuid())
  userId           String
  reason           String
  bookingId        String?
  penaltyPoints    Int      @default(1)
  coolingDownUntil DateTime 
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@map("user_penalties")
}

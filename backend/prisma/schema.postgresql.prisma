datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  USER
  ADMIN_UNIV
  ADMIN_YAYASAN
}

enum BookingStatus {
  PENDING
  RECOMMENDED
  APPROVED
  REJECTED
  RETURNED
  CANCELED
}

enum ActivityType {
  SEMINAR
  WORKSHOP
  KULIAH
  RAPAT
  PELATIHAN
  KUNJUNGAN
  AKREDITASI
  LAINNYA
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  passwordHash String?
  fullName     String
  email        String?
  unitName     String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  bookings     Booking[]
  approvals    ApprovalLog[]
  feedbacks    Feedback[]

  @@map("users")
}

model Floor {
  id    Int    @id @default(autoincrement())
  name  String @unique
  level Int
  rooms Room[]

  @@map("floors")
}

model Room {
  id            String    @id @default(uuid())
  floorId       Int
  name          String
  capacity      Int
  isSpecialRoom Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  floor         Floor     @relation(fields: [floorId], references: [id])
  bookings      Booking[]

  @@map("rooms")
}

model Booking {
  id                   String        @id @default(uuid())
  userId               String
  roomId               String
  title                String
  activityType         ActivityType
  startTime            DateTime
  endTime              DateTime
  status               BookingStatus @default(PENDING)
  additionalFacilities String[]
  notes                String?
  attachmentUrl        String?
  isLeaderApproved     Boolean       @default(false)
  isAcademicBulk       Boolean       @default(false)
  bulkGroupId          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id])
  room                 Room          @relation(fields: [roomId], references: [id])
  approvalLogs         ApprovalLog[]
  feedback             Feedback?

  @@index([roomId, startTime, endTime])
  @@map("bookings")
}

model ApprovalLog {
  id         String        @id @default(uuid())
  bookingId  String
  approverId String
  fromStatus BookingStatus
  toStatus   BookingStatus
  notes      String?
  createdAt  DateTime      @default(now())

  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  approver   User          @relation(fields: [approverId], references: [id])

  @@map("approval_logs")
}

model Feedback {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  userId            String
  cleanlinessRating Int
  facilityRating    Int
  staffRating       Int
  overallRating     Float
  comments          String?
  reportedIssues    String?
  createdAt         DateTime @default(now())

  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

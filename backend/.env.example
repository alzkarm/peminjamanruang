# ==============================================================================
# SIPERU YARSI - Backend Environment Template
# ==============================================================================
# Gunakan file ini sebagai acuan pembuatan environment backend:
# - Untuk dev lokal   : gunakan backend/.env.development atau backend/.env
# - Untuk server prod : gunakan backend/.env.production atau backend/.env
# ==============================================================================

# Mode & Port Server NestJS
PORT=4000
NODE_ENV=production

# Koneksi Database PostgreSQL
DATABASE_URL="postgresql://siperu_user:change_password@localhost:5432/siperu_yarsi?schema=public"

# Keamanan & Token JWT
JWT_SECRET="change-this-with-a-random-secret-string"
JWT_EXPIRES_IN="7d"

# CORS & URL Frontend
CORS_ORIGINS="https://siperu.yarsi.ac.id,http://siperu.yarsi.ac.id"
FRONTEND_URL="https://siperu.yarsi.ac.id"

# LDAP Server Configuration (Single Sign-On YARSI)
LDAP_HOST=pdc.yarsi.ac.id
LDAP_PORT=389
LDAP_BASE_DN=dc=yarsi,dc=ac,dc=id
LDAP_NETWORK_TIMEOUT=5000

# LDAP SSO
LDAP_URL=ldap://pdc.yarsi.ac.id:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=dc=yarsi,dc=ac,dc=id
LDAP_SEARCH_FILTER=(uid={{username}})

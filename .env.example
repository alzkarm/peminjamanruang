# ==============================================================================
# SIPERU YARSI - Frontend Environment Template
# ==============================================================================
# Gunakan file ini sebagai acuan pembuatan file environment:
# - Untuk dev lokal   : gunakan .env.development (otomatis terbaca saat `npm run dev`)
# - Untuk server prod : gunakan .env.production (otomatis terbaca saat `npm run build`)
# ==============================================================================

# URL Website & API publik
NEXT_PUBLIC_SITE_URL=https://siperu.yarsi.ac.id
NEXT_PUBLIC_API_URL=https://siperu.yarsi.ac.id/api

# Internal Backend URL (Next.js server-side / SSR ke NestJS)
BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api

# Aplikasi & Status Environment (development / production)
NEXT_PUBLIC_APP_NAME="SIPERU YARSI"
NEXT_PUBLIC_ENV=production

# JWT Secret Token Key
JWT_SECRET=change_with_your_super_secure_jwt_secret_key

# LDAP Server Configuration (SSO YARSI)
LDAP_URL=ldap://pdc.yarsi.ac.id:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=dc=yarsi,dc=ac,dc=id
LDAP_SEARCH_FILTER=(uid={{username}})
